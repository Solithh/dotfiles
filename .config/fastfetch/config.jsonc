{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
      "logo": {
    "source": "Arch_small",
    "type": "auto",
        "padding": {"top": 2, "left": 1},
    "color": {"1": "#B4BEFE", "2": "#B4BEFE"}
},
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#B4BEFE",
            "title": "#B4BEFE"
        }
    },
    "modules": [
        "break",
        {

            "type": "os",
            "key": "  os",
            "keyColor": "#B4BEFE",
            "format": "{2} {9}"
        },
        "break",
        {
            "type": "kernel",
            "key": "  kernel",
            "keyColor": "#B4BEFE"
        },
        "break",
        {
            "type": "packages",
            "key": "󰮯  packages",
            "keyColor": "#B4BEFE"
        },
        "break",
        {
            "type": "shell",
            "key": "  shell",
            "keyColor": "#B4BEFE"
        },
        "break",
        {
            "type": "uptime",
            "key": "  uptime",
            "keyColor": "#B4BEFE"
        },
        "break",
        {
            "type": "memory",
            "key": "  memory",
            "keyColor": "#B4BEFE"
        }
    ]
}
